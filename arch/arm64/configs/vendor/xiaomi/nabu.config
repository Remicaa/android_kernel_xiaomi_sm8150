# Platform
CONFIG_MACH_XIAOMI_NABU=y

# Audio
CONFIG_SND_SOC_CS35L41_V2=y
CONFIG_MSM_CSPL_V2=y

# Power
CONFIG_BATT_VERIFY_BY_DS28E16_NABU=y
CONFIG_ONEWIRE_GPIO_NABU=y
CONFIG_IDT_P9418=y
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_CHARGER_LN8000=y

# Touchscreen
CONFIG_TOUCHSCREEN_NT36523_HOSTDL_SPI=y
CONFIG_TOUCHSCREEN_NVT_DEBUG_FS=y

# Optimization
CONFIG_THINLTO=y

# BakaSU & SuSFS Root Stealth Solution
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
# CONFIG_KSU_MANUAL_HOOK is not set
# CONFIG_KSU_TRACEPOINT_HOOK is not set
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
# CONFIG_KSU_SUSFS_ENABLE_LOG is not set
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KALLSYMS=y

# Memory & ZRAM Optimization
CONFIG_ZRAM_WRITEBACK=y

# Phase 2: Smoothness & I/O Optimization
CONFIG_SCSI_MQ_DEFAULT=y

# Phase 3: TCP BBR Congestion Control
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y

# Phase 5: Docker on Termux Support
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_BRIDGE_NETFILTER=y

# Phase 5: Kali NetHunter External Wi-Fi Drivers & Injection
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_ATH9K_HTC=y
CONFIG_RTL8187=y
CONFIG_88XXAU=m
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_MT7601U=y
CONFIG_AIC_WLAN_SUPPORT=y
CONFIG_AIC_LOADFW_SUPPORT=m
CONFIG_AIC8800_WLAN_SUPPORT=m

# Phase 5: Kali NetHunter Bluetooth USB HCI
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_ATH3K=y





